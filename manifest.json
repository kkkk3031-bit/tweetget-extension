{
  "manifest_version": 3,
  "name": "TweetGet Downloader",
  "description": "Download videos and images from Twitter/X — powered by tweetget-production.up.railway.app",
  "version": "1.5.1",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TweetGet Downloader"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://tweetget-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/styles/inject.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tweetget@khaledq8",
      "strict_min_version": "109.0"
    }
  }
}